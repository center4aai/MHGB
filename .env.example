# Copy to .env and fill in. Never commit .env.

# --- Self-hosted models -----------------------------------------------------
# Ollama endpoint (open-weight participants and the primary judge).
# NativeOllamaClient rewrites the trailing /v1 to /api/chat automatically.
OLLAMA_API_BASE=http://localhost:11434/v1

# llama.cpp endpoint (secondary judge, and the generator used to build the graph)
GENERATOR_API_BASE=http://localhost:8080/v1
GENERATOR_MODEL=qwen3.6-27b

# --- Proprietary API models -------------------------------------------------
# In our runs all five proprietary models were reached through one
# OpenAI-compatible gateway. Point these at your gateway, or edit
# configs/models.yaml to use each provider's own endpoint.
PROPRIETARY_API_BASE=https://your-openai-compatible-gateway/v1
PROPRIETARY_API_KEY=

# --- Russian-adapted API models ---------------------------------------------
# YandexGPT: Api-Key from Yandex Cloud IAM. The folder id lives in model_id
# inside configs/models.yaml.
YANDEX_API_KEY=

# GigaChat (Sber): base64(client_id:client_secret)
GIGACHAT_CREDENTIALS=

# --- Storage (optional) -----------------------------------------------------
# Only needed for --save-mongo; the pipeline writes JSONL without it.
MONGODB_URI=mongodb://localhost:27017/mhgb
